{
  "id": null,
  "uid": "benchmark-http",
  "title": "Benchmark - HTTP",
  "tags": ["benchmark", "k6"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": [
    {"name": "target", "label": "Target", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(k6_http_reqs_total, target)", "refId": "target"}, "includeAll": true, "allValue": ".*", "refresh": 1},
    {"name": "run_id", "label": "Run ID", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(k6_http_reqs_total{target=~\"$target\"}, run_id)", "refId": "run"}, "includeAll": true, "allValue": ".*", "refresh": 1}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "RPS", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (target) (rate(k6_http_reqs_total{target=~\"$target\",run_id=~\"$run_id\"}[30s]))", "legendFormat": "{{target}}"}]},
    {"id": 2, "type": "timeseries", "title": "Latência p50 / p90 / p95 / p99", "gridPos": {"x": 8, "y": 0, "w": 16, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ms"}}, "targets": [{"refId": "A", "expr": "k6_http_req_duration_p50{target=~\"$target\",run_id=~\"$run_id\"}", "legendFormat": "p50 {{target}}"}, {"refId": "B", "expr": "k6_http_req_duration_p90{target=~\"$target\",run_id=~\"$run_id\"}", "legendFormat": "p90 {{target}}"}, {"refId": "C", "expr": "k6_http_req_duration_p95{target=~\"$target\",run_id=~\"$run_id\"}", "legendFormat": "p95 {{target}}"}, {"refId": "D", "expr": "k6_http_req_duration_p99{target=~\"$target\",run_id=~\"$run_id\"}", "legendFormat": "p99 {{target}}"}]},
    {"id": 3, "type": "timeseries", "title": "Taxa de erros", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}}, "targets": [{"refId": "A", "expr": "k6_http_req_failed_rate{target=~\"$target\",run_id=~\"$run_id\"}", "legendFormat": "{{target}}"}]},
    {"id": 4, "type": "timeseries", "title": "Checks", "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "k6_checks_rate{target=~\"$target\",run_id=~\"$run_id\"}", "legendFormat": "{{target}}"}]},
    {"id": 5, "type": "timeseries", "title": "Iterações descartadas", "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "increase(k6_dropped_iterations_total{target=~\"$target\",run_id=~\"$run_id\"}[1m])", "legendFormat": "{{target}}"}]},
    {"id": 6, "type": "timeseries", "title": "CPU versus throughput", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (target) (rate(k6_http_reqs_total{target=~\"$target\",run_id=~\"$run_id\"}[30s]))", "legendFormat": "RPS {{target}}"}, {"refId": "B", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total[30s]))", "legendFormat": "CPU {{name}}"}]},
    {"id": 7, "type": "timeseries", "title": "Memória versus throughput", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (target) (rate(k6_http_reqs_total{target=~\"$target\",run_id=~\"$run_id\"}[30s]))", "legendFormat": "RPS {{target}}"}, {"refId": "B", "expr": "container_memory_working_set_bytes", "legendFormat": "memory {{name}}"}]}
  ]
}
